{
  "name": "confluence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @confluence/api exec prisma generate",
    "db:migrate": "pnpm --filter @confluence/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @confluence/api exec prisma db seed",
    "db:studio": "pnpm --filter @confluence/api exec prisma studio",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d postgres redis coturn mailpit minio",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "infra:nuke": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "stack:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --build",
    "test:e2e": "pnpm --filter @confluence/web test:e2e",
    "mail:test": "pnpm --filter @confluence/api mail:test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
