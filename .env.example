# ---------------------------------------------------------------------------
# Copy to .env and fill in. The API validates these with Zod at boot and
# refuses to start if any are missing or malformed (spec section 5).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# --- Postgres ---
POSTGRES_USER=confluence
POSTGRES_PASSWORD=confluence_dev_pw
POSTGRES_DB=confluence
POSTGRES_PORT=5432
DATABASE_URL=postgresql://confluence:confluence_dev_pw@localhost:5432/confluence?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- coturn (consumed in Phase 3 for HMAC-derived ephemeral credentials) ---
TURN_REALM=confluence.local
TURN_STATIC_AUTH_SECRET=change_me_dev_only_turn_secret
TURN_PORT=3478
# Host browsers use to reach coturn (they run outside Docker).
TURN_HOST=localhost
# Deployed, a hosted TURN service replaces coturn. Cloudflare Realtime mints
# credentials per call from an API token (dash.cloudflare.com -> Realtime ->
# TURN); nothing else to configure, and the token stays on the server.
# CLOUDFLARE_TURN_TOKEN_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Or any other TURN service: its URLs (comma-separated) and fixed credentials.
# TURN_URLS=stun:stun.example.com:3478,turn:relay.example.com:3478?transport=udp
# TURN_USERNAME=
# TURN_PASSWORD=

# --- Auth (Phase 1) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_dev_only_access_secret
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret

# --- Email (verification and password reset) ---
# SMTP_HOST is the switch.
#   Commented out: every email lands in Mailpit, a local inbox at
#     http://localhost:8025, and nothing leaves this machine.
#   Set: email is sent for real through that SMTP server.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, and paste its 16 letters into
# SMTP_PASS (your normal Google password will not work). About 500 emails a day.
# Check it with: pnpm mail:test you@example.com   (restart the API after edits)
# The end-to-end tests read mail from Mailpit: comment SMTP_HOST out to run them.
MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM="Confluence <you@gmail.com>"

# --- Object storage (Phase 5: encrypted files) ---
# Local: MinIO from docker compose (console at http://localhost:9001).
# Production: any S3-compatible store. The endpoint the API uses and the one
# the BROWSER uses for presigned URLs can differ (e.g. inside Docker).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=confluence-files
S3_ACCESS_KEY=confluence
S3_SECRET_KEY=change_me_dev_only_s3_secret

# --- Web (Vite; only VITE_* reach the browser bundle) ---
VITE_API_URL=http://localhost:4000
# The API's WebSocket origin, for the production CSP (wss:// behind TLS).
API_WS_ORIGIN=ws://localhost:4000
