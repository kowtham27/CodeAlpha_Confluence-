# ---------------------------------------------------------------------------
# Copy to .env and fill in. The API validates these with Zod at boot and
# refuses to start if any are missing or malformed (spec section 5).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# --- Postgres ---
POSTGRES_USER=confluence
POSTGRES_PASSWORD=confluence_dev_pw
POSTGRES_DB=confluence
POSTGRES_PORT=5432
DATABASE_URL=postgresql://confluence:confluence_dev_pw@localhost:5432/confluence?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- coturn (consumed in Phase 3 for HMAC-derived ephemeral credentials) ---
TURN_REALM=confluence.local
TURN_STATIC_AUTH_SECRET=change_me_dev_only_turn_secret
TURN_PORT=3478

# --- Auth (Phase 1) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_dev_only_access_secret
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret

# --- Email (Phase 1: verification) ---
# Dev: Mailpit catches everything; read it at http://localhost:8025
# Prod: any SMTP provider (Resend, Postmark, SES...). Set SMTP_SECURE=true
# for port 465, and SMTP_USER / SMTP_PASS.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Confluence <no-reply@confluence.local>"

# --- Web (Vite; only VITE_* reach the browser bundle) ---
VITE_API_URL=http://localhost:4000
