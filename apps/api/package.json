{
  "name": "@confluence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "mail:test": "tsx src/scripts/send-test-email.ts",
    "gmail:auth": "tsx src/scripts/gmail-auth.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@confluence/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.9",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "socket.io": "4.8.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@confluence/crypto": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9",
    "@types/node": "26.5.1",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
